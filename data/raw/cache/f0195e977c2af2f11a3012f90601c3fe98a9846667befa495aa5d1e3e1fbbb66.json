{"batchcomplete":"","continue":{"gsroffset":5,"continue":"gsroffset||"},"query":{"pages":{"51570377":{"pageid":51570377,"ns":6,"title":"File:Brassica oleracea var. capitata (4170722993).jpg","index":5,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Brassica_oleracea_var._capitata_%284170722993%29.jpg/500px-Brassica_oleracea_var._capitata_%284170722993%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":400,"thumbheight":300,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Brassica_oleracea_var._capitata_%284170722993%29.jpg/960px-Brassica_oleracea_var._capitata_%284170722993%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Brassica_oleracea_var._capitata_%284170722993%29.jpg/500px-Brassica_oleracea_var._capitata_%284170722993%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":400,"height":300,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Brassica_oleracea_var._capitata_%284170722993%29.jpg/960px-Brassica_oleracea_var._capitata_%284170722993%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/7/74/Brassica_oleracea_var._capitata_%284170722993%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Brassica_oleracea_var._capitata_(4170722993).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=51570377","extmetadata":{"DateTime":{"value":"2016-09-20 14:05:50","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Brassica oleracea var. capitata (4170722993)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Cabbage|Brassica oleracea var. capitata|Flickr images reviewed by FlickreviewR|Photographs by Dinesh Valke","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/search/?q=Brassicaceae&amp;w=91314344@N00&amp;m=tags\">Brassicaceae</a> (mustard, or cabbage family)\u00a0\u00bb <i><a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/search/?q=Brassicaoleraceavarcapitata&amp;w=91314344@N00&amp;m=tags&amp;z=m\">Brassica oleracea</a></i> var. <i>capitata</i>\n</p><p><b>BRAS-ee-ka</b> -- from the classical Latin name for cabbage\n<b>awl-lur-RAY-see-uh</b> -- edible vegetable\n<b>kap-ih-TAY-tuh</b> -- having a head, referring to growth habit\n</p><p><b>commonly known as</b>: cabbage \u2022 <b>Assamese</b>: \u09ac\u09a8\u09cd\u09a7\u09be-\u0995\u09ac\u09bf bandha kobi \u2022 <b>Bengali</b>: \u09ac\u09be\u0981\u09a7\u09be\u0995\u09aa\u09bf bandhakopi \u2022 <b>Gujarati</b>: \u0a95\u0acb\u0aac\u0ac0 kobi, \u0a95\u0acb\u0aac\u0ac0\u0a9c kobij \u2022 <b>Hindi</b>: \u092c\u0902\u0926 \u0917\u094b\u092d\u0940 band gobhi, \u0917\u094b\u092d\u0940 gobhi, \u0915\u094b\u092c\u0940 kobi, \u092a\u093e\u0924 \u0917\u094b\u092d\u0940 paat gobhi, \u092a\u0924\u094d\u0924\u093e \u0917\u094b\u092d\u0940 patta gobhi \u2022 <b>Kannada</b>: \u0c8e\u0cb2\u0cc6\u0c95\u0ccb\u0cb8\u0cc1 elekosu, \u0c95\u0ccb\u0cb8\u0cc1\u0c97\u0cc6\u0ca1\u0ccd\u0ca1\u0cc6 kosugedde \u2022 <b>Konkani</b>: \u0915\u0933\u0947 kale, \u0915\u094b\u092c\u0940 kobi, \u0915\u094b\u0938\u0941 kosu, \u092a\u093e\u0932\u094d\u0932\u0947 paalle \u2022 <b>Lushai</b>: antam \u2022 <b>Malayalam</b>: \u0d2e\u0d41\u0d1f\u0d4d\u0d1f\u0d15\u0d4d\u0d15\u0d4b\u0d38\u0d4d muttakkoos \u2022 <b>Manipuri</b>: kobiful \u2022 <b>Marathi</b>: \u0915\u094b\u092c\u0940 kobi \u2022 <b>Nepali</b>: \u0917\u094b\u092c\u093f gobi \u2022 <b>Oriya</b>: bandha kobi \u2022 <b>Punjabi</b>: \u0a2c\u0a70\u0a26 \u0a17\u0a4b\u0a2d\u0a40 band gobhi \u2022 <b>Sanskrit</b>: \u0915\u092a\u093f\u0915\u092e\u094d kapikam, \u0915\u092a\u093f\u0936\u093e\u0915\u0903 kapishakah \u2022 <b>Sindhi</b>: \u067e\u064e\u0646\u064e\u06af\u0648\u0628\u064a\u0650 pana gobii \u2022 <b>Sinhalese</b>: gova \u2022 <b>Tamil</b>: \u0b95\u0bcb\u0bb5\u0bbf\u0b9a\u0bc1 kovicu, \u0bae\u0bc1\u0b9f\u0bcd\u0b9f\u0bc8\u0b95\u0bcd\u0b95\u0bcb\u0b9a\u0bc1 muttai-k-kocu \u2022 <b>Telugu</b>: \u0c15\u0c4b\u0c38\u0c41 kosu \u2022 <b>Urdu</b>: \u06af\u0648\u0628\u0647\u06cc gobhi, \u06a9\u0648\u0628\u064a kobi\n</p><p><b>Distribution</b>: only cultivated\n</p>\n<b>References</b>: <a rel=\"nofollow\" class=\"external text\" href=\"http://envis.frlht.org.in/plant_details.php?disp_id=364\">ENVIS - FRLHT</a> \u2022 <a rel=\"nofollow\" class=\"external text\" data-mw-original-href=\"http://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?7672\" href=\"https://www.ars-grin.gov/cgi-bin/npgs/html/taxon.pl?7672\">NPGS / GRIN</a> \u2022 <a rel=\"nofollow\" class=\"external text\" href=\"http://dsal.uchicago.edu/dictionaries/\">DDSA</a>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2009-12-07 15:38","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/dinesh_valke/4170722993/\">Brassica oleracea var. capitata</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/91314344@N00\">Dinesh Valke</a> from Thane, India","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.