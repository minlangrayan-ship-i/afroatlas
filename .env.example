# Public browser configuration only. Use the project's legacy anon JWT key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional anonymous event counters require explicit visitor consent and server configuration.
PUBLIC_USAGE_METRICS_ENABLED=false
# Never place service_role, database passwords or owner passwords here or in GitHub variables.
# Production URL including base path; leave blank to preserve the existing GitHub Pages URL.
SITE_URL=
# Enable only for the Cloudflare packaging command; never publish this build directly to GitHub Pages.
ADMIN_GATEWAY_ENABLED=false
