---
import { activeAdvertisement } from '../lib/advertising';
const { location = 'home' } = Astro.props;
const placement = activeAdvertisement(location);
---

{placement && (
  <aside
    class="ad-slot"
    aria-label="Publicité"
    data-placement={location}
    data-size={placement?.sizeVariant || 'banner'}
    data-enabled="true"
  >
    <span>Publicité</span>
    <a href={placement.targetUrl!} rel="sponsored noopener noreferrer" target="_blank">
      {placement.sponsorLabel}
    </a>
  </aside>
)}
