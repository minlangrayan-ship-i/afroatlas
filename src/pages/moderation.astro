---
import Layout from '../components/Layout.astro';
import Moderation from '../components/Moderation';
const protectedGateway = import.meta.env.ADMIN_GATEWAY_ENABLED === 'true';
---

<Layout title="Modération propriétaire">
  <section class="container page-intro">
    <h1>Modération propriétaire</h1>
    <p>Les propositions reçues restent privées jusqu’à leur validation.</p>
  </section>
  <section class="container page-body">
    {protectedGateway ? (
      <Moderation client:load />
    ) : (
      <p class="notice">
        Administration indisponible sur cet hébergement statique. L’accès propriétaire nécessite
        l’hébergement protégé et la configuration serveur.
      </p>
    )}
  </section>
</Layout>
