---
import Layout from '../../components/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ProductActions from '../../components/ProductActions';
import PhotoZoom from '../../components/PhotoZoom';
import NamesTable from '../../components/NamesTable';
import CommunityUpdates from '../../components/CommunityUpdates';
import ShopCard from '../../components/ShopCard';
import {
  products,
  catalogue,
  imageFor,
  namesFor,
  commercial,
  cardProducts,
} from '../../lib/catalogue';
import { href } from '../../lib/links';
import { categories, countries } from '../../data/countries';
import {
  evidenceLabel,
  productChoice,
  isBoilerplate,
  glanceNames,
  commonName,
} from '../../lib/presentation';
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const image = imageFor(product.id),
  names = namesFor(product.id);
const rows = names.map((name) => {
  const proof = catalogue.evidence.find((e) => e.id === name.evidenceIds[0])!;
  return {
    ...name,
    sourceUrl: catalogue.sources.find((s) => s.id === proof.sourceId)!.url,
    locator: proof.locator,
    proofs: name.evidenceIds.map((id) => {
      const e = catalogue.evidence.find((e) => e.id === id)!;
      return { url: catalogue.sources.find((s) => s.id === e.sourceId)!.url, locator: e.locator };
    }),
  };
});
const french = commonName(product, names, 'fr'),
  english = commonName(product, names, 'en'),
  arabic = commonName(product, names, 'ar');
const glance = glanceNames(product, names);
const methodNote = isBoilerplate(product.description);
const lead = methodNote
  ? `${product.labelFr}${product.formTypes.length ? ` — ${product.formTypes.join(', ')}` : ''}.`
  : product.description;
const contexts = catalogue.contexts.filter((c) => c.productId === product.id);
const related = products.filter((p) =>
  catalogue.relations.some(
    (r) =>
      (r.fromId === product.id && r.toId === p.id) || (r.toId === product.id && r.fromId === p.id),
  ),
);
const references = commercial.references.filter((r) =>
  r.relations.some((rel) => rel.productId === product.id),
);
const category = categories.find((c) => c.id === product.categoryId)!;
const alsoKnown =
  english && !product.labelFr.toLowerCase().includes(english.name.toLowerCase())
    ? ` (${english.name})`
    : '';
const title = `${product.labelFr}${alsoKnown} : ses noms selon les langues et les pays`;
const glanceText = glance
  .slice(0, 4)
  .map((n) => (n.language === 'Nom local' ? n.name : `${n.name} (${n.language.toLowerCase()})`))
  .join(', ');
const seoDescription = (
  `${product.labelFr}${product.scientificName ? ` (${product.scientificName})` : ''}` +
  (glanceText ? ` : ${glanceText}. ` : '. ') +
  'Photo, noms par langue et par pays, sources.'
).slice(0, 220);
const breadcrumbs = [
  { name: 'Accueil', path: '' },
  { name: category.label, path: `categories/${category.id}/` },
  { name: product.labelFr, path: `produits/${product.slug}/` },
];
const structuredData = [
  {
    '@type': 'DefinedTerm',
    name: product.labelFr,
    description: product.description,
    url: new URL(href(`produits/${product.slug}/`), Astro.site).href,
    termCode: product.id,
    inDefinedTermSet: new URL(href(), Astro.site).href,
    alternateName: [...new Set(names.filter((n) => n.nameType !== 'input').map((n) => n.name))],
  },
];
const nameProofs = Object.fromEntries(rows.map((n) => [n.id, n.proofs]));
const contextProofs = Object.fromEntries(
  contexts.map((c) => [c.id, catalogue.sources.find((s) => s.id === c.sourceId)!.url]),
);
---

<Layout
  title={title}
  description={seoDescription}
  image={image.role === 'primary' ? image.localPath : undefined}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <nav class="container breadcrumbs" aria-label="Fil d’Ariane">
    <a href={href()}>Accueil</a> / <a href={href(`categories/${category.id}/`)}>{category.label}</a>
    <span> / </span>
    <span>{product.labelFr}</span>
  </nav>
  <section class="container product-hero">
    <div>
      <PhotoZoom image={image} label={product.labelFr} productId={product.id} client:load />
      {(image.role === 'primary' || image.verificationStatus === 'visually_checked') && (
        <details class="photo-attribution">
          <summary>Crédit de la photographie</summary>
          <p class="photo-credit">
            {image.creatorUrl ? (
              <a href={image.creatorUrl} target="_blank" rel="noopener noreferrer">
                {image.creator}
              </a>
            ) : (
              image.creator
            )}{' '}
            ·{' '}
            <a href={image.sourcePageUrl} target="_blank" rel="noopener noreferrer">
              Source ↗
            </a>{' '}
            ·{' '}
            <a href={image.licenseUrl} target="_blank" rel="noopener noreferrer">
              {image.licenseId}
            </a>
            <small>{image.modifications}</small>
          </p>
        </details>
      )}
    </div>
    <div class="product-summary">
      <p class="eyebrow">{categories.find((c) => c.id === product.categoryId)?.label}</p>
      <h1
        data-product-label
        data-no-translate
        data-fr={product.labelFr}
        data-en={english?.name || ''}
        data-ar={arabic?.name || ''}
      >
        {product.labelFr}
      </h1>
      <p class="scientific">{product.scientificName}</p>
      <p class="product-lead" data-no-translate dir="auto">
        {lead}
      </p>
      {glance.length > 0 && (
        <div class="names-glance">
          <h2>Aussi appelé</h2>
          <ul>
            {glance.map((n) => (
              <li>
                <strong data-no-translate dir="auto" lang={n.languageCode || undefined}>
                  {n.name}
                </strong>
                <small>
                  {n.language}
                  {n.countryIds.length > 0 &&
                    ` · ${n.countryIds
                      .map((id) => countries.find((c) => c.ISO3 === id)?.nameFr || id)
                      .join(', ')}`}
                </small>
              </li>
            ))}
          </ul>
          <a class="text-link" href="#appellations">
            Toutes les appellations et leurs sources ↓
          </a>
        </div>
      )}
      <div class="summary-facts">
        <span>{productChoice(product).title}</span>
        <span>{product.formTypes.join(', ')}</span>
        {product.entityType === 'commercial-category' && <span>Plusieurs espèces possibles</span>}
        {product.documentaryScope === 'organism' && <span>Plante ou organisme</span>}
      </div>
      <ProductActions id={product.id} share client:load />
    </div>
  </section>
  <ShopCard
    product={cardProducts.find((p) => p.id === product.id)!}
    proofs={nameProofs}
    contextProofs={contextProofs}
    client:load
  />
  <section class="container documentary-sections">
    <details class="documentary-detail" id="appellations">
      <summary>Appellations détaillées, langues et contextes</summary>
      <NamesTable names={rows} client:load />
    </details>
    <details class="documentary-detail">
      <summary>Parties, formes et usages documentés</summary>
      <div class="detail-columns">
        <article class="shop-guide">
          <p class="eyebrow">COMMENT LE DEMANDER EN BOUTIQUE ?</p>
          <h2>Commencez par un nom documenté.</h2>
          <dl>
            <dt>Libellé français de la source</dt>
            <dd data-no-translate dir="auto">
              {french?.name || 'Non renseigné'}
            </dd>
            <dt>Libellé anglais de la source</dt>
            <dd data-no-translate dir="auto">
              {english?.name || 'Non renseigné'}
            </dd>
            <dt>Libellé arabe de la source</dt>
            <dd data-no-translate dir="auto" lang="ar">
              {arabic?.name || 'Non renseigné'}
            </dd>
            <dt>Forme de la fiche</dt>
            <dd>{product.formTypes.join(', ')}</dd>
            {product.consumedPart && (
              <>
                <dt>
                  {product.documentaryScope === 'organism'
                    ? 'Identité couverte'
                    : 'Partie consommée'}
                </dt>
                <dd data-no-translate dir="auto">
                  {evidenceLabel(product.consumedPart)}
                </dd>
              </>
            )}
          </dl>
          <p>
            Montrez la photographie et précisez la forme recherchée. Ces libellés ne prouvent pas le
            nom utilisé par une boutique.
          </p>
        </article>
        <article class="usage-guide">
          <p class="eyebrow">USAGES & FORMES</p>
          <h2>Ce que cette fiche établit.</h2>
          <p>
            {product.usage ||
              'Les usages culinaires régionaux et les formes préparées ne sont pas encore documentés dans cet instantané.'}
          </p>
          <ul>
            {product.sourceIds.map((id) => {
              const source = catalogue.sources.find((s) => s.id === id)!;
              return (
                <li>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-no-translate
                    dir="auto"
                  >
                    {source.title} ↗
                  </a>
                </li>
              );
            })}
          </ul>
          <p>
            Aucune équivalence entre produit brut, séché, fumé ou moulu n’est présumée. Les mélanges
            et plats préparés nécessitent une fiche propre.
          </p>
          <a class="text-link" href={href(`contribuer/?product=${product.slug}`)}>
            Compléter avec une source ↗
          </a>
        </article>
      </div>
    </details>
    <CommunityUpdates productId={product.id} client:load />
    <div class="container">
      <AdSlot location="product-after-main-info" />
    </div>
    {contexts.length > 0 && (
      <details class="documentary-detail">
        <summary>Usages locaux et périmètres des sources</summary>
        <div class="source-cards">
          {contexts.map((context) => (
            <article class="shop-guide" dir="auto">
              <h3 data-no-translate>{context.localContext}</h3>
              <p data-no-translate>{context.description}</p>
              <p>
                Forme concernée : {context.form} ·{' '}
                {countries.find((c) => c.ISO3 === context.countryId)?.nameFr ||
                  'Contexte non établi'}
              </p>
              <a
                href={catalogue.sources.find((s) => s.id === context.sourceId)!.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Source ↗
              </a>
              <small>{evidenceLabel(context.locator)}</small>
            </article>
          ))}
        </div>
      </details>
    )}
    <details class="documentary-detail">
      <summary>Références commerciales et conditionnement</summary>
      <p>
        {references.length
          ? `${references.length} référence${references.length > 1 ? 's' : ''} reliée${references.length > 1 ? 's' : ''} par une preuve.`
          : 'Aucune référence commerciale reliée par une preuve à cette fiche pour le moment.'}
      </p>
      <a class="text-link" href={href('references/')}>
        Consulter les références séparément ↗
      </a>
    </details>
  </section>
  <section class="container section">
    <div class="section-header">
      <div>
        <p class="eyebrow">CATÉGORIE VOISINE, PAS ÉQUIVALENCE</p>
        <h2>À distinguer également.</h2>
      </div>
    </div>
    <div class="related-grid">
      {related.map((p) => (
        <a href={href(`produits/${p.slug}/`)}>
          {imageFor(p.id).role === 'primary' && (
            <img
              src={href(imageFor(p.id).smallPath)}
              alt={imageFor(p.id).altFr}
              width="200"
              height="150"
              loading="lazy"
            />
          )}
          <span>
            <span
              data-product-label
              data-no-translate
              data-fr={p.labelFr}
              data-en={p.labelEn || ''}
              data-ar={namesFor(p.id).find((n) => n.languageCode === 'ar')?.name || ''}
            >
              {p.labelFr}
            </span>
            <small>Produits liés, identités distinctes</small>
          </span>
          <b>↗</b>
        </a>
      ))}
    </div>
  </section>
  <section class="container documentary-sections">
    <details class="documentary-detail source-section">
      <summary>Sources, crédits et limites</summary>
      {methodNote && (
        <p data-no-translate dir="auto">
          {product.description}
        </p>
      )}
      <p>{product.editorialNote}</p>
      <p class="verification-date">
        Dernier contrôle d’import : <time datetime={product.verifiedAt}>{product.verifiedAt}</time>.
        Aucun examen culturel humain enregistré.
      </p>
      {product.scientificNames && <p class="scientific">{product.scientificNames.join(' · ')}</p>}
      {catalogue.sources
        .filter((s) => product.sourceIds.includes(s.id))
        .map((s) => (
          <p>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.title} ↗
            </a>{' '}
            · {s.licenseId} · révision {s.datasetVersion} · importé le {s.retrievedAt}
            {s.accessNote && (
              <small class="table-note" data-no-translate dir="auto">
                {s.accessNote}
              </small>
            )}
          </p>
        ))}
      <p>
        Les alias linguistiques ne prouvent ni usage géographique, ni usage culinaire, ni présence
        en boutique. Pour un nom ambigu, consultez toutes les fiches candidates dans la recherche.
      </p>
      <p>
        Explorer les contextes d’appellation :{' '}
        {[...new Set(names.flatMap((n) => n.countryIds))].map((id) => (
          <a href={href(`pays/${id.toLowerCase()}/`)}>{id} ↗ </a>
        ))}
      </p>
      <a class="button secondary" href={href(`contribuer/?product=${product.slug}`)}>
        Contribuer à la bibliothèque
      </a>
    </details>
  </section>
  <script>
    // Opening a folded section from a link such as « Toutes les appellations ↓ ».
    const openTarget = () => {
      const target = location.hash && document.getElementById(location.hash.slice(1));
      if (target instanceof HTMLDetailsElement) target.open = true;
    };
    addEventListener('hashchange', openTarget);
    openTarget();
  </script>
</Layout>
