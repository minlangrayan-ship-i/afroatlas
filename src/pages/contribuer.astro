---
import Layout from '../components/Layout.astro';
import Contribution from '../components/ContributionForm';
import { products } from '../lib/catalogue';
---

<Layout title="Contribuer à la bibliothèque">
  <div class="container page-intro">
    <p class="eyebrow">LES BONNES SOURCES FONT LA DIFFÉRENCE</p>
    <h1>Contribuer à la bibliothèque</h1>
    <p>Vous connaissez un autre nom pour ce produit ? Aidez-nous à enrichir AfroAtlas.</p>
  </div>
  <section class="container page-body narrow">
    <Contribution
      products={products.map((p) => ({ id: p.id, slug: p.slug, labelFr: p.labelFr }))}
      client:load
    />
  </section>
</Layout>
